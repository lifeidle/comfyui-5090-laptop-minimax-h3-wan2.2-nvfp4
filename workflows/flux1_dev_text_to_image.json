{
  "_meta": {
    "name": "FLUX.1-dev fp8 all-in-one · text to image",
    "based_on": "comfyui_workflow_templates_json/templates/flux_dev_checkpoint_example.json",
    "note": "flux1-dev-fp8.safetensors 是 all-in-one（model+text_encoders+vae），走 CheckpointLoaderSimple",
    "official_params": {"steps": 20, "cfg": 1.0, "sampler": "euler", "scheduler": "simple", "latent": "EmptySD3LatentImage 1024x1024"}
  },
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "flux1-dev-fp8.safetensors"}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "a serene chinese ink painting of bamboo forest, misty mountains, xuan paper texture, 印章朱红 accent", "clip": ["1", 1]}},
  "3": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["2", 0]}},
  "4": {"class_type": "EmptySD3LatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "5": {"class_type": "KSampler", "inputs": {"model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0], "seed": 20260922, "steps": 20, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "6": {"class_type": "VAEDecode", "inputs": {"samples": ["5", 0], "vae": ["1", 2]}},
  "7": {"class_type": "SaveImage", "inputs": {"images": ["6", 0], "filename_prefix": "p3_flux1_dev"}}
}
